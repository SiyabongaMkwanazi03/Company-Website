<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- SEO -->
<title><%= locals.pageTitle || "SMK DIGITALS | AI Solutions & Automation for SMEs" %></title>

<meta
    name="description"
    content="<%= locals.pageDescription || 'SMK DIGITALS provides AI automation, AI chatbots, business process automation and AI solutions designed to help small and medium businesses grow and operate more efficiently.' %>"
>

<meta
    name="robots"
    content="index, follow"
>

<link
    rel="canonical"
    href="https://smkdigitals.co.za<%= locals.canonicalPath || '/' %>"
>

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content="website">

<meta
    property="og:title"
    content="<%= locals.pageTitle || 'SMK DIGITALS | AI Solutions & Automation for SMEs' %>"
>

<meta
    property="og:description"
    content="<%= locals.pageDescription || 'AI automation and business solutions helping SMEs improve efficiency, generate leads and grow.' %>"
>

<meta
    property="og:url"
    content="https://smkdigitals.co.za<%= locals.canonicalPath || '/' %>"
>

<meta
    property="og:site_name"
    content="SMK DIGITALS"
>

<meta
    property="og:image"
    content="https://smkdigitals.co.za/images/og-image.jpg"
>

<!-- Twitter / X -->
<meta
    name="twitter:card"
    content="summary_large_image"
>

<meta
    name="twitter:title"
    content="<%= locals.pageTitle || 'SMK DIGITALS | AI Solutions & Automation for SMEs' %>"
>

<meta
    name="twitter:description"
    content="<%= locals.pageDescription || 'AI automation and business solutions helping SMEs improve efficiency, generate leads and grow.' %>"
>

<meta
    name="twitter:image"
    content="https://smkdigitals.co.za/images/og-image.jpg"
>

<!-- Theme -->
<meta name="theme-color" content="#000000">

<!-- Favicon -->
<link
    rel="icon"
    type="image/png"
    href="/images/favicon.png"
>

<!-- Font Awesome -->
<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
>

<!-- Main stylesheet -->
<link
    rel="stylesheet"
    href="/css/style.css"
>

<!-- Structured Data / Schema.org -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "SMK DIGITALS",
    "url": "https://smkdigitals.co.za/",
    "logo": "https://smkdigitals.co.za/images/logo.png",
    "description": "SMK DIGITALS provides AI automation, AI chatbots, business process automation and AI solutions for small and medium businesses.",
    "email": "info@smkdigitals.co.za",
    "telephone": "+27659227155",
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "1202 MK Street CHLOORKOP EXT 51",
        "addressLocality": "Johannesburg",
        "addressCountry": "ZA"
    },
    "areaServed": {
        "@type": "Country",
        "name": "South Africa"
    },
    "sameAs": [
        "https://www.instagram.com/",
        "https://www.facebook.com/",
        "https://www.linkedin.com/"
    ]
}
</script>