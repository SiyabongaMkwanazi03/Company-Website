<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        /* ===== ARTICLE MODAL STYLES - COMPACT READER ===== */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            justify-content: center;
            align-items: center;
            overflow-y: auto;
            padding: 20px;
        }

        .modal-content {
            position: relative;
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 26, 77, 0.9) 100%);
            border: 2px solid rgba(255, 140, 0, 0.3);
            border-radius: 12px;
            padding: 40px;
            max-width: 700px;
            width: 100%;
            max-height: 85vh;
            overflow-y: auto;
            box-shadow: 0 0 30px rgba(255, 140, 0, 0.3),
                        0 0 60px rgba(255, 140, 0, 0.1);
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 140, 0, 0.2);
        }

        .close-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255, 140, 0, 0.1);
            border: 1px solid rgba(255, 140, 0, 0.3);
            color: #ffffff;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 24px;
            flex-shrink: 0;
        }

        .close-button:hover {
            background: rgba(255, 140, 0, 0.2);
            border-color: #ff8c00;
            color: #ff8c00;
            transform: scale(1.1);
        }

        .article-detail {
            color: #d8e0f0;
        }

        .article-detail h2 {
            color: #ffffff;
            font-size: 28px;
            margin: 0 0 15px 0;
            line-height: 1.4;
        }

        .article-detail .article-tag {
            display: inline-block;
            background: rgba(255, 140, 0, 0.15);
            color: #ff8c00;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            padding: 6px 16px;
            border-radius: 25px;
            margin-bottom: 16px;
        }

        .article-detail .article-meta {
            display: flex;
            gap: 20px;
            margin-bottom: 25px;
            font-size: 13px;
            color: #a0a0a0;
        }

        .article-body {
            line-height: 1.8;
            color: #d8e0f0;
            margin-bottom: 0;
        }

        .article-body p {
            margin-bottom: 16px;
            font-size: 15px;
        }

        .article-body p:first-child {
            font-size: 15px;
            font-weight: 500;
        }

        .article-body p:last-child {
            margin-bottom: 0;
        }

        /* Responsive modal */
        @media (max-width: 768px) {
            .modal {
                padding: 15px;
                align-items: flex-start;
            }

            .modal-content {
                padding: 30px 20px;
                width: 100%;
                max-width: 100%;
                max-height: 90vh;
                margin-top: 20px;
                border-radius: 8px;
            }

            .article-detail h2 {
                font-size: 22px;
                margin-bottom: 12px;
            }

            .article-body p {
                font-size: 14px;
                margin-bottom: 14px;
            }

            .modal-header {
                margin-bottom: 25px;
                padding-bottom: 15px;
            }
        }

        @media (max-width: 480px) {
            .modal {
                padding: 10px;
            }

            .modal-content {
                padding: 20px 15px;
                max-height: 92vh;
            }

            .article-detail h2 {
                font-size: 19px;
                margin-bottom: 10px;
            }

            .article-detail .article-tag {
                font-size: 11px;
                padding: 5px 12px;
                margin-bottom: 12px;
            }

            .article-detail .article-meta {
                font-size: 12px;
                gap: 15px;
                margin-bottom: 20px;
            }

            .article-body p {
                font-size: 13.5px;
                margin-bottom: 12px;
            }

            .close-button {
                width: 32px;
                height: 32px;
                font-size: 20px;
            }
        }
    </style>
</head>

<body>

    <%- include('partials/navbar', { active: active }) %>

    <main>

        <!-- Hero Section -->
        <section id="hero">
            <div class="hero-text">
                <h2>AI News & Business Insights</h2>
                <p>
                    Practical insights on how artificial intelligence is helping
                    small and medium businesses improve efficiency, generate more
                    leads, reduce costs, and create better customer experiences.
                </p>
            </div>
        </section>


        <!-- Media Hub Section -->
        <section id="media-hub">

            <!-- Filter Bar -->
            <div class="media-filter-bar">
                <button class="active" onclick="filterArticles('all', this)">
                    All
                </button>

                <button onclick="filterArticles('news', this)">
                    News
                </button>

                <button onclick="filterArticles('insights', this)">
                    Insights
                </button>
            </div>


            <!-- Featured Article -->
            <div class="featured-article">
                <div class="featured-content">

                    <span class="article-tag">AI Insights</span>

                    <h3>
                        How AI Is Helping Small Businesses Work Smarter and Generate More Leads
                    </h3>

                    <div class="article-meta">
                        <span>August 14, 2026</span>
                        <span>6 min read</span>
                    </div>

                    <p>
                        AI is no longer only for large corporations. Small and medium
                        businesses can now use AI to automate repetitive work, respond
                        to customers faster, improve marketing, and turn more enquiries
                        into leads.
                    </p>

                    <a href="#" class="read-more" onclick="openArticle(event, 0)">
                        Read full story &rarr;
                    </a>

                </div>
            </div>


            <!-- Articles Grid -->
            <div class="media-grid">

                <!-- Article 1 -->
                <div class="article-card" data-category="insights">

                    <span class="article-tag">Insights</span>

                    <h3>
                        5 Ways AI Can Increase Efficiency in Your Small Business
                    </h3>

                    <div class="article-meta">
                        <span>August 12, 2026</span>
                        <span>5 min read</span>
                    </div>

                    <p>
                        Discover how AI can automate repetitive tasks, reduce manual
                        work, and give your team more time to focus on customers and growth.
                    </p>

                    <a href="#" class="read-more" onclick="openArticle(event, 1)">
                        Read more &rarr;
                    </a>

                </div>


                <!-- Article 2 -->
                <div class="article-card" data-category="news">

                    <span class="article-tag">News</span>

                    <h3>
                        AI Is Changing How SMEs Generate and Convert Leads
                    </h3>

                    <div class="article-meta">
                        <span>August 8, 2026</span>
                        <span>4 min read</span>
                    </div>

                    <p>
                        From AI-powered chatbots to automated follow-ups, businesses
                        are finding new ways to capture enquiries and turn potential
                        customers into real opportunities.
                    </p>

                    <a href="#" class="read-more" onclick="openArticle(event, 2)">
                        Read more &rarr;
                    </a>

                </div>


                <!-- Article 3 -->
                <div class="article-card" data-category="insights">

                    <span class="article-tag">Insights</span>

                    <h3>
                        How AI Chatbots Can Improve Customer Service for SMEs
                    </h3>

                    <div class="article-meta">
                        <span>August 4, 2026</span>
                        <span>6 min read</span>
                    </div>

                    <p>
                        AI chatbots can help businesses answer common questions,
                        qualify leads, provide support, and remain available outside
                        normal business hours.
                    </p>

                    <a href="#" class="read-more" onclick="openArticle(event, 3)">
                        Read more &rarr;
                    </a>

                </div>


                <!-- Article 4 -->
                <div class="article-card" data-category="news">

                    <span class="article-tag">News</span>

                    <h3>
                        Why More Small Businesses Are Turning to AI Automation
                    </h3>

                    <div class="article-meta">
                        <span>July 30, 2026</span>
                        <span>5 min read</span>
                    </div>

                    <p>
                        AI automation is becoming more accessible to smaller
                        businesses, helping them streamline operations without
                        needing large teams or expensive technology departments.
                    </p>

                    <a href="#" class="read-more" onclick="openArticle(event, 4)">
                        Read more &rarr;
                    </a>

                </div>


                <!-- Article 5 -->
                <div class="article-card" data-category="insights">

                    <span class="article-tag">Insights</span>

                    <h3>
                        How SMEs Can Use AI to Turn More Enquiries Into Customers
                    </h3>

                    <div class="article-meta">
                        <span>July 24, 2026</span>
                        <span>7 min read</span>
                    </div>

                    <p>
                        Learn how AI can help businesses respond faster, follow up
                        automatically, qualify prospects, and improve the customer journey.
                    </p>

                    <a href="#" class="read-more" onclick="openArticle(event, 5)">
                        Read more &rarr;
                    </a>

                </div>

            </div>


            <!-- Contact Button -->
            <a href="/contact" class="btn">
                Get in Touch
            </a>

        </section>


        <!-- Modal for Article Details -->
        <div id="articleModal" class="modal">

            <div class="modal-content">

                <div class="modal-header">
                    <button class="close-button" onclick="closeArticle()" title="Back to articles">
                        ← Back
                    </button>
                </div>

                <div class="article-detail">

                    <span class="article-tag" id="modalTag"></span>

                    <h2 id="modalTitle"></h2>

                    <div class="article-meta">
                        <span id="modalDate"></span>
                    </div>

                    <div id="modalBody" class="article-body"></div>

                </div>

            </div>

        </div>

    </main>


    <%- include('partials/footer') %>

    <%- include('partials/scripts') %>


    <script>

        // ============================================================
        // ARTICLE DATABASE
        // ============================================================

        const articles = [

            // --------------------------------------------------------
            // ARTICLE 0
            // --------------------------------------------------------

            {
                id: 0,

                title: "How AI Is Helping Small Businesses Work Smarter and Generate More Leads",

                category: "news",

                date: "August 14, 2026",

                content: `
AI is changing the way small and medium businesses operate. What was once technology mainly available to large corporations is becoming increasingly accessible to smaller businesses.

For SMEs, the biggest opportunity is not simply using AI because it is popular. The real opportunity is using AI to solve practical business problems.

AI can help businesses automate repetitive administrative tasks, respond to customers faster, manage enquiries, support employees, and improve marketing activities.

Lead generation is another major opportunity. AI can help businesses capture enquiries from websites, social media and messaging platforms, qualify potential customers, and automatically follow up with prospects.

For example, instead of a potential customer submitting an enquiry and waiting several hours for a response, an AI-powered system can respond immediately, answer common questions, collect important information and notify the business when human intervention is required.

AI can also help businesses understand their customers better. By analysing customer interactions and enquiries, businesses can identify common questions, customer needs and opportunities for improvement.

The result is not simply more technology. It is a business that can respond faster, operate more efficiently and spend more time focusing on growth.

For small and medium businesses, AI should be viewed as a tool for increasing capacity rather than replacing people. The businesses that successfully adopt AI will be those that combine technology with strong human decision-making and customer relationships.
`
            },


            // --------------------------------------------------------
            // ARTICLE 1
            // --------------------------------------------------------

            {
                id: 1,

                title: "5 Ways AI Can Increase Efficiency in Your Small Business",

                category: "insights",

                date: "August 17, 2026",

                content: `
Small businesses often operate with limited resources. Owners and employees may have to manage sales, customer service, administration, marketing and operations at the same time.

AI can help reduce this pressure by taking care of repetitive and time-consuming activities.

1. Automating Administrative Tasks

AI automation can help organise information, process enquiries, generate documents and move information between different business systems.

2. Faster Customer Responses

AI assistants and chatbots can answer frequently asked questions instantly, helping customers get information without waiting for an employee.

3. Automated Lead Follow-Ups

Many businesses lose potential customers because enquiries are not followed up quickly enough. AI can help automate follow-up messages and remind teams when a prospect requires personal attention.

4. Faster Content Creation

AI can assist businesses with creating social media posts, email campaigns, product descriptions and other marketing content.

5. Better Internal Knowledge

AI knowledge systems can help employees quickly find information about company processes, products, services and frequently asked questions.

The goal is not to automate everything. The goal is to identify repetitive tasks that consume valuable time and allow AI to handle them.

When used correctly, AI gives small businesses the ability to operate more efficiently while allowing employees to focus on activities that require human judgement, creativity and relationships.
`
            },


            // --------------------------------------------------------
            // ARTICLE 2
            // --------------------------------------------------------

            {
                id: 2,

                title: "AI Is Changing How SMEs Generate and Convert Leads",

                category: "news",

                date: "August 15, 2026",

                content: `
Generating leads is one of the biggest challenges for many small and medium businesses.

Traditional marketing can attract potential customers, but businesses can still lose opportunities when enquiries are not answered quickly or when prospects are not followed up consistently.

AI is changing this process.

AI-powered systems can help businesses capture enquiries from websites, social media platforms and messaging channels.

Once a potential customer makes contact, AI can ask relevant questions, identify what the customer is looking for and determine whether the enquiry is a suitable sales opportunity.

AI can also help businesses follow up with potential customers automatically.

For example, if someone requests information about a service but does not immediately purchase, an automated system can send a follow-up message at an appropriate time.

This creates a more consistent customer journey.

AI can also help sales teams prioritise leads. Instead of treating every enquiry the same, businesses can use information from customer interactions to identify which prospects are more likely to become customers.

The result is a sales process that can respond faster, follow up more consistently and reduce the number of opportunities that are forgotten.

For SMEs, this can be particularly valuable because every potential customer matters.
`
            },


            // --------------------------------------------------------
            // ARTICLE 3
            // --------------------------------------------------------

            {
                id: 3,

                title: "How AI Chatbots Can Improve Customer Service for SMEs",

                category: "insights",

                date: "August 4, 2026",

                content: `
Customer expectations are changing. People increasingly expect businesses to respond quickly when they have questions or need assistance.

For small businesses with limited staff, responding to every enquiry immediately can be difficult.

AI chatbots can help solve this problem.

An AI chatbot can handle common customer questions, provide information about products and services, collect customer details and direct complex requests to a human employee.

One of the biggest advantages is availability.

An AI assistant can continue responding to customers outside normal business hours. This means a potential customer does not necessarily have to wait until the next morning to receive an initial response.

AI chatbots can also support lead generation.

Instead of simply answering questions, a chatbot can ask potential customers what service they are interested in, collect their contact information and determine what they need.

The information can then be passed to the sales team.

However, AI should not completely replace human customer service.

The best approach is to use AI for repetitive and straightforward interactions while allowing employees to handle complex, sensitive or high-value conversations.

This creates a combination of automation and human service that can improve the overall customer experience.
`
            },


            // --------------------------------------------------------
            // ARTICLE 4
            // --------------------------------------------------------

            {
                id: 4,

                title: "Why More Small Businesses Are Turning to AI Automation",

                category: "news",

                date: "July 30, 2026",

                content: `
AI automation is becoming increasingly relevant to small and medium businesses.

For many SMEs, the challenge is not a lack of ideas or opportunities. It is the amount of manual work required to operate the business.

Employees may spend hours responding to repetitive emails, copying information between systems, updating spreadsheets, processing enquiries and performing administrative tasks.

AI automation can connect these processes and reduce unnecessary manual work.

For example, a new website enquiry could automatically be recorded in a customer management system, categorised, sent to the relevant employee and followed up with an automated message.

Another example is customer service.

When a customer asks a common question, an AI assistant can provide an immediate response. More complex questions can then be passed to a human employee.

This allows employees to focus on higher-value activities.

AI automation can also help businesses scale.

Instead of requiring additional employees for every increase in enquiries or administrative work, businesses can automate parts of their existing processes.

The goal is not to remove people from the business.

The goal is to help people spend less time on repetitive work and more time on customers, sales, strategy and growth.

For SMEs, that can make AI automation a practical tool for increasing operational efficiency.
`
            },


            // --------------------------------------------------------
            // ARTICLE 5
            // --------------------------------------------------------

            {
                id: 5,

                title: "How SMEs Can Use AI to Turn More Enquiries Into Customers",

                category: "insights",

                date: "July 24, 2026",

                content: `
Getting enquiries is only the beginning of the sales process.

A business can generate hundreds of potential leads, but if those leads are not contacted, qualified and followed up properly, many opportunities can be lost.

AI can help businesses improve this process.

The first opportunity is response speed.

AI systems can respond to enquiries immediately instead of forcing potential customers to wait for an employee.

The second opportunity is lead qualification.

An AI assistant can ask questions to understand the customer's needs, budget, location, service requirements or other relevant information.

This allows the business to identify which enquiries require immediate attention.

The third opportunity is automated follow-up.

If a potential customer does not respond immediately, AI can help maintain communication through scheduled and personalised follow-ups.

The fourth opportunity is customer personalisation.

AI can use information from previous interactions to help businesses provide more relevant responses and recommendations.

Finally, AI can help businesses identify patterns in their leads.

Businesses can analyse which services generate the most enquiries, where leads are coming from and where potential customers are dropping out of the sales process.

The result is a more organised and responsive lead-generation system.

For SMEs, improving the way existing enquiries are handled can be just as important as finding new sources of leads.
`
            }

        ];


        // ============================================================
        // CURRENT ARTICLE
        // ============================================================

        let currentArticleIndex = 0;


        // ============================================================
        // FILTER ARTICLES
        // ============================================================

        function filterArticles(category, btn) {

            document
                .querySelectorAll('.media-filter-bar button')
                .forEach(b => b.classList.remove('active'));

            btn.classList.add('active');


            document
                .querySelectorAll('.article-card')
                .forEach(card => {

                    if (
                        category === 'all' ||
                        card.dataset.category === category
                    ) {

                        card.style.display = 'flex';

                    } else {

                        card.style.display = 'none';

                    }

                });

        }


        // ============================================================
        // OPEN ARTICLE
        // ============================================================

        function openArticle(event, index) {

            event.preventDefault();

            currentArticleIndex = index;

            const article = articles[index];


            document.getElementById('modalTitle').textContent =
                article.title;


            document.getElementById('modalTag').textContent =
                article.category.toUpperCase();


            document.getElementById('modalTag').style.background =
                getCategoryColor(article.category);


            document.getElementById('modalDate').textContent =
                article.date;


            document.getElementById('modalBody').innerHTML =
                article.content
                    .split('\n')
                    .map(p => p.trim() ? `<p>${p}</p>` : '')
                    .join('');


            document.getElementById('articleModal').style.display =
                'flex';


            document.body.style.overflow = 'hidden';

        }


        // ============================================================
        // CLOSE ARTICLE
        // ============================================================

        function closeArticle() {

            document.getElementById('articleModal').style.display =
                'none';

            document.body.style.overflow = 'auto';

        }


        // ============================================================
        // CATEGORY COLORS
        // ============================================================

        function getCategoryColor(category) {

            const colors = {

                news: 'rgba(255, 140, 0, 0.15)',

                insights: 'rgba(100, 200, 255, 0.15)'

            };

            return colors[category] ||
                'rgba(255, 140, 0, 0.15)';

        }


        // ============================================================
        // CLOSE MODAL WHEN CLICKING OUTSIDE
        // ============================================================

        window.onclick = function(event) {

            const modal =
                document.getElementById('articleModal');

            if (event.target === modal) {

                closeArticle();

            }

        };


        // ============================================================
        // CLOSE MODAL WITH ESCAPE
        // ============================================================

        document.addEventListener('keydown', function(event) {

            if (event.key === 'Escape') {

                closeArticle();

            }

        });

    </script>

</body>
</html>