<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- SEO -->
<title><%= locals.pageTitle || "AI Solutions, Automation, Software, Web Development & AI Governance | SMK Digitals" %></title>

<meta
    name="description"
    content="<%= locals.pageDescription || 'SMK Digitals is a South African AI Governance, Risk & Compliance (AI GRC) company helping organisations manage AI governance, identify technology risks, strengthen compliance readiness, and adopt AI responsibly.' %>"
>

<meta name="robots" content="index, follow">

<link
    rel="canonical"
    href="https://smkdigitals.co.za<%= locals.canonicalPath || '/' %>"
>

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content="website">

<meta
    property="og:title"
    content="<%= locals.pageTitle || 'AI Solutions, Automation, Software, Web Development & AI Governance | SMK Digitals' %>"
>

<meta
    property="og:description"
    content="<%= locals.pageDescription || 'SMK Digitals helps organisations harness the power of technology and AI through innovative solutions, intelligent automation, custom software, and web development, while supporting responsible adoption through effective governance, risk management, and compliance.' %>"
>

<meta
    property="og:url"
    content="https://smkdigitals.co.za<%= locals.canonicalPath || '/' %>"
>

<meta
    property="og:site_name"
    content="SMK Digitals"
>

<meta
    property="og:image"
    content="https://smkdigitals.co.za/images/og-image.jpg"
>

<!-- Twitter / X -->
<meta
    name="twitter:card"
    content="summary_large_image"
>

<meta
    name="twitter:title"
    content="<%= locals.pageTitle || 'AI Solutions, Automation, Software, Web Development & AI Governance | SMK Digitals' %>"
>

<meta
    name="twitter:description"
    content="<%= locals.pageDescription || 'SMK Digitals helps organisations harness the power of technology and AI through innovative solutions, intelligent automation, custom software, and web development, while supporting responsible adoption through effective governance, risk management, and compliance.' %>"
>

<meta
    name="twitter:image"
    content="https://smkdigitals.co.za/images/og-image.jpg"
>

<!-- Theme -->
<meta name="theme-color" content="#000000">

<!-- Favicon -->
<link rel="icon" href="/images/favicon.png" type="image/png">
<link rel="shortcut icon" href="/images/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/images/favicon.png">

<!-- Font Awesome -->
<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
>

<!-- Main stylesheet -->
<link
    rel="stylesheet"
    href="/css/style.css"
>

<!-- Structured Data / Schema.org -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "SMK Digitals",
    "alternateName": "SMK DIGITALS (PTY) LTD",
    "url": "https://smkdigitals.co.za/",
    "logo": "https://smkdigitals.co.za/images/company.png",
    "description": "SMK Digitals is a South African AI Solutions, Automation, Software, and Web Development company.",
    "email": "info@smkdigitals.co.za",
    "telephone": "+27659227155",
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "1202 MK Street CHLOORKOP EXT 51",
        "addressLocality": "Johannesburg",
        "addressRegion": "Gauteng",
        "addressCountry": "ZA"
    },
    "areaServed": {
        "@type": "Country",
        "name": "South Africa"
    },
    "sameAs": [
        "https://www.instagram.com/smk_digitals",
        "https://www.facebook.com/smkdigitals",
        "https://www.linkedin.com/company/smk-digitals"
    ]
}
</script>