<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        /* ===== ARTICLE MODAL STYLES - COMPACT READER ===== */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            justify-content: center;
            align-items: center;
            overflow-y: auto;
            padding: 20px;
        }

        .modal-content {
            position: relative;
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 26, 77, 0.9) 100%);
            border: 2px solid rgba(255, 140, 0, 0.3);
            border-radius: 12px;
            padding: 40px;
            max-width: 700px;
            width: 100%;
            max-height: 85vh;
            overflow-y: auto;
            box-shadow: 0 0 30px rgba(255, 140, 0, 0.3),
                        0 0 60px rgba(255, 140, 0, 0.1);
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 140, 0, 0.2);
        }

        .close-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255, 140, 0, 0.1);
            border: 1px solid rgba(255, 140, 0, 0.3);
            color: #ffffff;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 24px;
            flex-shrink: 0;
        }

        .close-button:hover {
            background: rgba(255, 140, 0, 0.2);
            border-color: #ff8c00;
            color: #ff8c00;
            transform: scale(1.1);
        }

        .article-detail {
            color: #d8e0f0;
        }

        .article-detail h2 {
            color: #ffffff;
            font-size: 28px;
            margin: 0 0 15px 0;
            line-height: 1.4;
        }

        .article-detail .article-tag {
            display: inline-block;
            background: rgba(255, 140, 0, 0.15);
            color: #ff8c00;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            padding: 6px 16px;
            border-radius: 25px;
            margin-bottom: 16px;
        }

        .article-detail .article-meta {
            display: flex;
            gap: 20px;
            margin-bottom: 25px;
            font-size: 13px;
            color: #a0a0a0;
        }

        .article-body {
            line-height: 1.8;
            color: #d8e0f0;
            margin-bottom: 0;
        }

        .article-body p {
            margin-bottom: 16px;
            font-size: 15px;
        }

        .article-body p:first-child {
            font-size: 15px;
            font-weight: 500;
        }

        .article-body p:last-child {
            margin-bottom: 0;
        }

        /* Responsive modal */
        @media (max-width: 768px) {
            .modal {
                padding: 15px;
                align-items: flex-start;
            }

            .modal-content {
                padding: 30px 20px;
                width: 100%;
                max-width: 100%;
                max-height: 90vh;
                margin-top: 20px;
                border-radius: 8px;
            }

            .article-detail h2 {
                font-size: 22px;
                margin-bottom: 12px;
            }

            .article-body p {
                font-size: 14px;
                margin-bottom: 14px;
            }

            .modal-header {
                margin-bottom: 25px;
                padding-bottom: 15px;
            }
        }

        @media (max-width: 480px) {
            .modal {
                padding: 10px;
            }

            .modal-content {
                padding: 20px 15px;
                max-height: 92vh;
            }

            .article-detail h2 {
                font-size: 19px;
                margin-bottom: 10px;
            }

            .article-detail .article-tag {
                font-size: 11px;
                padding: 5px 12px;
                margin-bottom: 12px;
            }

            .article-detail .article-meta {
                font-size: 12px;
                gap: 15px;
                margin-bottom: 20px;
            }

            .article-body p {
                font-size: 13.5px;
                margin-bottom: 12px;
            }

            .close-button {
                width: 32px;
                height: 32px;
                font-size: 20px;
            }
        }
    </style>
</head>

<body>

    <%- include('partials/navbar', { active: active }) %>

    <main>

    <!-- Hero Section -->
    <section id="hero">
        <div class="hero-text">
            <h2>AI Governance, Risk &amp; Compliance Insights</h2>
            <p>
                Practical insights on AI governance, responsible AI, risk management,
                compliance, and emerging technology to help organisations adopt and
                manage artificial intelligence with confidence.
            </p>
        </div>
    </section>


    <!-- Media Hub Section -->
    <section id="media-hub">

        <!-- Filter Bar -->
        <div class="media-filter-bar">
            <button class="active" onclick="filterArticles('all', this)">
                All
            </button>

            <button onclick="filterArticles('governance', this)">
                Governance
            </button>

            <button onclick="filterArticles('risk', this)">
                Risk
            </button>

            <button onclick="filterArticles('compliance', this)">
                Compliance
            </button>

            <button onclick="filterArticles('insights', this)">
                Insights
            </button>
        </div>


        <!-- Featured Article -->
        <div class="featured-article">
            <div class="featured-content">

                <span class="article-tag">AI Governance</span>

                <h3>
                    Why Businesses Need AI Governance Before Scaling Artificial Intelligence
                </h3>

                <div class="article-meta">
                    <span>August 14, 2026</span>
                    <span>6 min read</span>
                </div>

                <p>
                    As organisations adopt AI across their operations, governance is
                    becoming essential. Businesses need clear accountability, risk
                    controls, policies, and oversight to ensure AI is used responsibly
                    and aligned with organisational requirements.
                </p>

                <a href="#" class="read-more" onclick="openArticle(event, 0)">
                    Read full story &rarr;
                </a>

            </div>
        </div>


        <!-- Articles Grid -->
        <div class="media-grid">

            <!-- Article 1 -->
            <div class="article-card" data-category="governance">

                <span class="article-tag">Governance</span>

                <h3>
                    What Is AI Governance and Why Does Your Organisation Need It?
                </h3>

                <div class="article-meta">
                    <span>August 12, 2026</span>
                    <span>5 min read</span>
                </div>

                <p>
                    AI governance provides the structures, policies, roles, and
                    accountability organisations need to manage how artificial
                    intelligence is used.
                </p>

                <a href="#" class="read-more" onclick="openArticle(event, 1)">
                    Read more &rarr;
                </a>

            </div>


            <!-- Article 2 -->
            <div class="article-card" data-category="risk">

                <span class="article-tag">Risk</span>

                <h3>
                    5 AI Risks Every Growing Business Should Understand
                </h3>

                <div class="article-meta">
                    <span>August 8, 2026</span>
                    <span>6 min read</span>
                </div>

                <p>
                    AI can create risks involving privacy, security, accuracy,
                    bias, transparency, third-party providers, and business
                    operations. Understanding these risks is the first step
                    toward managing them.
                </p>

                <a href="#" class="read-more" onclick="openArticle(event, 2)">
                    Read more &rarr;
                </a>

            </div>


            <!-- Article 3 -->
            <div class="article-card" data-category="compliance">

                <span class="article-tag">Compliance</span>

                <h3>
                    AI Compliance: What Businesses Should Consider Before Deployment
                </h3>

                <div class="article-meta">
                    <span>August 4, 2026</span>
                    <span>6 min read</span>
                </div>

                <p>
                    Before deploying AI, organisations should consider applicable
                    legal, regulatory, privacy, security, industry, and internal
                    policy requirements.
                </p>

                <a href="#" class="read-more" onclick="openArticle(event, 3)">
                    Read more &rarr;
                </a>

            </div>


            <!-- Article 4 -->
            <div class="article-card" data-category="risk">

                <span class="article-tag">Risk</span>

                <h3>
                    Shadow AI: The Hidden Risk of Employees Using AI Tools
                </h3>

                <div class="article-meta">
                    <span>July 30, 2026</span>
                    <span>5 min read</span>
                </div>

                <p>
                    Employees may already be using AI tools without formal
                    organisational approval. Understanding shadow AI and creating
                    responsible usage controls can help reduce unnecessary risk.
                </p>

                <a href="#" class="read-more" onclick="openArticle(event, 4)">
                    Read more &rarr;
                </a>

            </div>


            <!-- Article 5 -->
            <div class="article-card" data-category="governance">

                <span class="article-tag">Governance</span>

                <h3>
                    How to Build an AI Governance Framework for Your Organisation
                </h3>

                <div class="article-meta">
                    <span>July 24, 2026</span>
                    <span>7 min read</span>
                </div>

                <p>
                    A practical AI governance framework can define accountability,
                    policies, risk management processes, human oversight, vendor
                    controls, and ongoing monitoring.
                </p>

                <a href="#" class="read-more" onclick="openArticle(event, 5)">
                    Read more &rarr;
                </a>

            </div>

        </div>


        <!-- Contact Button -->
        <a href="/contact" class="btn">
            Get in Touch
        </a>

    </section>


    <!-- Modal for Article Details -->
    <div id="articleModal" class="modal">

        <div class="modal-content">

            <div class="modal-header">
                <button
                    class="close-button"
                    onclick="closeArticle()"
                    title="Back to articles"
                >
                    ← Back
                </button>
            </div>

            <div class="article-detail">

                <span class="article-tag" id="modalTag"></span>

                <h2 id="modalTitle"></h2>

                <div class="article-meta">
                    <span id="modalDate"></span>
                </div>

                <div id="modalBody" class="article-body"></div>

            </div>

        </div>

    </div>

</main>


<script>

    // ============================================================
    // ARTICLE DATABASE
    // ============================================================

    const articles = [

        // --------------------------------------------------------
        // ARTICLE 0
        // --------------------------------------------------------

        {
            id: 0,

            title: "Why Businesses Need AI Governance Before Scaling Artificial Intelligence",

            category: "governance",

            date: "August 14, 2026",

            content: `
AI adoption is expanding across organisations of all sizes. Businesses are using artificial intelligence for customer service, analysis, productivity, marketing, operations and decision support.

However, adopting AI without governance can create unnecessary risks.

AI governance provides the structures an organisation needs to determine how AI should be used, who is responsible for it, what risks need to be managed and what controls should be in place.

Good governance starts with understanding the organisation's AI landscape.

Businesses should know which AI systems are being used, which employees use them, what information is processed, which vendors are involved and what decisions are influenced by AI.

Governance should also establish clear accountability.

Employees and management should understand who is responsible for approving AI systems, monitoring risks, reviewing vendors and responding to incidents.

The goal of AI governance is not to stop organisations from using AI.

The goal is to help organisations use AI responsibly while maintaining appropriate oversight, risk management and accountability.

As AI becomes increasingly embedded in business operations, organisations that establish governance early can build a stronger foundation for responsible and sustainable AI adoption.
`
        },


        // --------------------------------------------------------
        // ARTICLE 1
        // --------------------------------------------------------

        {
            id: 1,

            title: "What Is AI Governance and Why Does Your Organisation Need It?",

            category: "governance",

            date: "August 12, 2026",

            content: `
AI governance is the system of policies, processes, responsibilities and controls used to manage an organisation's use of artificial intelligence.

It answers important questions such as who is accountable for AI, which systems are approved, how risks are assessed and how AI-related incidents should be handled.

The first step is visibility.

An organisation needs to know what AI systems and tools are currently being used across the business.

The second step is accountability.

Employees, managers and technology teams should understand their responsibilities when introducing or using AI.

The third step is risk management.

Each AI use case should be reviewed based on factors such as the type of data involved, the impact of the system, security concerns and the level of human oversight required.

The fourth step is ongoing monitoring.

AI governance should not be treated as a once-off project. AI systems, vendors, risks and regulatory expectations can change over time.

A strong AI governance framework helps organisations create consistency, accountability and confidence around the use of artificial intelligence.
`
        },


        // --------------------------------------------------------
        // ARTICLE 2
        // --------------------------------------------------------

        {
            id: 2,

            title: "5 AI Risks Every Growing Business Should Understand",

            category: "risk",

            date: "August 8, 2026",

            content: `
Artificial intelligence can create significant business value, but it can also introduce new risks.

Here are five important areas organisations should consider.

1. Privacy Risk

AI systems may process personal or confidential information. Organisations should understand what data is being used, where it goes and how it is handled.

2. Security Risk

AI systems and third-party AI services can introduce new security considerations. Businesses should evaluate access controls, integrations and data protection measures.

3. Accuracy and Reliability Risk

AI systems can produce incorrect or misleading results. Human review may be necessary, particularly when AI outputs influence important business decisions.

4. Bias and Fairness Risk

AI systems can produce unfair or inconsistent outcomes if they are trained or implemented poorly.

5. Third-Party Risk

Many organisations rely on external AI providers. Businesses should understand the risks associated with the vendors, platforms and services they use.

The objective is not to eliminate every AI risk.

The objective is to identify important risks, assess their potential impact and establish appropriate controls to manage them.
`
        },


        // --------------------------------------------------------
        // ARTICLE 3
        // --------------------------------------------------------

        {
            id: 3,

            title: "AI Compliance: What Businesses Should Consider Before Deployment",

            category: "compliance",

            date: "August 4, 2026",

            content: `
AI compliance is becoming increasingly important as organisations integrate artificial intelligence into business processes.

Before deploying an AI system, organisations should understand which legal, regulatory, privacy, security, industry and internal requirements may apply.

One important area is data.

Businesses should understand what information the AI system processes, why that information is being processed and how it is protected.

Organisations should also consider automated decision-making.

Where AI contributes to decisions that may significantly affect individuals, appropriate oversight and controls should be considered.

Documentation is another important part of compliance readiness.

Businesses should maintain records of AI systems, vendors, policies, assessments and decisions relevant to governance.

Compliance should also be reviewed continuously.

As AI systems change and organisations introduce new tools, governance and compliance requirements may need to be reassessed.

The objective is to ensure that AI adoption is supported by appropriate governance, documentation, accountability and risk management.
`
        },


        // --------------------------------------------------------
        // ARTICLE 4
        // --------------------------------------------------------

        {
            id: 4,

            title: "Shadow AI: The Hidden Risk of Employees Using AI Tools",

            category: "risk",

            date: "July 30, 2026",

            content: `
Shadow AI refers to employees using AI tools without formal organisational approval, oversight or governance.

Employees may use tools such as generative AI assistants, transcription services, writing tools or AI-powered productivity platforms to perform everyday work.

The problem is not necessarily the use of AI.

The problem is a lack of visibility.

An organisation may not know which tools employees are using, what information is being entered into those tools or whether those tools have been reviewed.

This can create privacy, security, confidentiality, compliance and operational risks.

Organisations can reduce shadow AI risks by creating clear AI usage policies.

Employees should understand which AI tools are approved, what information they may enter into AI systems and when human review is required.

Businesses should also provide practical training rather than simply banning AI tools.

Responsible AI adoption requires employees to understand both the opportunities and the risks associated with the technology.

The goal is to create controlled and informed AI use rather than uncontrolled AI adoption.
`
        },


        // --------------------------------------------------------
        // ARTICLE 5
        // --------------------------------------------------------

        {
            id: 5,

            title: "How to Build an AI Governance Framework for Your Organisation",

            category: "governance",

            date: "July 24, 2026",

            content: `
An AI governance framework provides the structure an organisation needs to manage artificial intelligence responsibly.

The first component is governance and accountability.

Organisations should define who is responsible for approving AI systems, managing risks and overseeing AI-related decisions.

The second component is an AI inventory.

Businesses should maintain a record of the AI systems and tools being used across the organisation.

The third component is risk management.

AI systems should be assessed based on factors such as privacy, security, accuracy, bias, transparency and operational impact.

The fourth component is policy.

Organisations should establish clear policies that define acceptable AI use, employee responsibilities, data handling requirements and oversight expectations.

The fifth component is vendor management.

AI providers and third-party systems should be assessed before they are introduced into critical business processes.

Finally, organisations need ongoing monitoring.

AI governance should evolve as systems, vendors, business requirements and regulatory expectations change.

A governance framework should therefore be practical, documented and continuously improved.

The goal is to create an environment where organisations can adopt AI while maintaining accountability, appropriate controls and responsible oversight.
`
        }

    ];


    // ============================================================
    // CURRENT ARTICLE
    // ============================================================

    let currentArticleIndex = 0;


    // ============================================================
    // FILTER ARTICLES
    // ============================================================

    function filterArticles(category, btn) {

        document
            .querySelectorAll('.media-filter-bar button')
            .forEach(b => b.classList.remove('active'));

        btn.classList.add('active');


        document
            .querySelectorAll('.article-card')
            .forEach(card => {

                if (
                    category === 'all' ||
                    card.dataset.category === category
                ) {

                    card.style.display = 'flex';

                } else {

                    card.style.display = 'none';

                }

            });

    }


    // ============================================================
    // OPEN ARTICLE
    // ============================================================

    function openArticle(event, index) {

        event.preventDefault();

        currentArticleIndex = index;

        const article = articles[index];


        document.getElementById('modalTitle').textContent =
            article.title;


        document.getElementById('modalTag').textContent =
            article.category.toUpperCase();


        document.getElementById('modalTag').style.background =
            getCategoryColor(article.category);


        document.getElementById('modalDate').textContent =
            article.date;


        document.getElementById('modalBody').innerHTML =
            article.content
                .split('\n')
                .map(p => p.trim() ? `<p>${p}</p>` : '')
                .join('');


        document.getElementById('articleModal').style.display =
            'flex';


        document.body.style.overflow = 'hidden';

    }


    // ============================================================
    // CLOSE ARTICLE
    // ============================================================

    function closeArticle() {

        document.getElementById('articleModal').style.display =
            'none';

        document.body.style.overflow = 'auto';

    }


    // ============================================================
    // CATEGORY COLORS
    // ============================================================

    function getCategoryColor(category) {

        const colors = {

            governance: 'rgba(255, 140, 0, 0.15)',

            risk: 'rgba(255, 90, 90, 0.15)',

            compliance: 'rgba(100, 200, 255, 0.15)',

            insights: 'rgba(130, 200, 140, 0.15)'

        };

        return colors[category] ||
            'rgba(255, 140, 0, 0.15)';

    }


    // ============================================================
    // CLOSE MODAL WHEN CLICKING OUTSIDE
    // ============================================================

    window.onclick = function(event) {

        const modal =
            document.getElementById('articleModal');

        if (event.target === modal) {

            closeArticle();

        }

    };


    // ============================================================
    // CLOSE MODAL WITH ESCAPE
    // ============================================================

    document.addEventListener('keydown', function(event) {

        if (event.key === 'Escape') {

            closeArticle();

        }

    });

</script>