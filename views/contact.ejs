<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar', { active: active }) %>

    <main>
        <section id="hero">
            <div class="hero-text">
                <h2>Get in Touch</h2>
                <p>Have a question or want to work with us? Send us a message and our team will get back to you shortly.</p>
            </div>
        </section>

        <section id="contact">
            <div class="contact-container">

                <div class="contact-info">
                    <h2>Contact Information</h2>

                    <div class="info-item">
                        <div class="info-icon">&#9993;</div>
                        <div class="info-content">
                            <h3>Email</h3>
                            <a href="mailto:info@smkdigitals.co.za">info@smkdigitals.co.za</a>
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-icon">&#9742;</div>
                        <div class="info-content">
                            <h3>Phone</h3>
                            <p>+27 65 922 7155</p>
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-icon">&#128205;</div>
                        <div class="info-content">
                            <h3>Address</h3>
                            <p>1202 MK Street CHLOORKOP EXT 51, Johannesburg, South Africa</p>
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-icon">&#128337;</div>
                        <div class="info-content">
                            <h3>Business Hours</h3>
                            <p>Mon &ndash; Fri: 8:00 AM &ndash; 5:00 PM</p>
                        </div>
                    </div>
                </div>

                <div class="contact-form">
                    <h3>Send Us a Message</h3>
                    <form action="/contact" method="POST">
                        <div class="input-group">
                            <label for="name">Full Name</label>
                            <input type="text" id="name" name="name" placeholder="Your name" required>
                        </div>

                        <div class="input-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" placeholder="you@example.com" required>
                        </div>

                        <div class="input-group">
                            <label for="subject">Subject</label>
                            <input type="text" id="subject" name="subject" placeholder="What's this about?" required>
                        </div>

                        <div class="input-group">
                            <label for="message">Message</label>
                            <textarea id="message" name="message" placeholder="Tell us a bit more..." required></textarea>
                        </div>

                        <button type="submit">Send Message</button>
                    </form>
                </div>

            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
</body>
</html>