<!DOCTYPE html>
<html lang="en">

<head>

    <%- include('partials/head', {
        pageTitle: "AI Governance, Risk & Compliance Services | SMK Digitals",
        pageDescription: "Explore SMK Digitals' AI Governance, Risk & Compliance services, including AI governance assessments, AI risk management, governance frameworks, compliance readiness, vendor risk assessments, and ongoing AI governance support.",
        canonicalPath: "/services"
    }) %>

</head>

<body>

    <%- include('partials/navbar', { active: active }) %>

    <main>

        <section id="services">

            <h2>Our AI Governance, Risk &amp; Compliance Services</h2>

            <p>
                SMK DIGITALS provides AI Governance, Risk &amp; Compliance (AI GRC)
                services that help organisations identify AI-related risks,
                establish effective governance, strengthen compliance readiness,
                and adopt artificial intelligence responsibly.
            </p>


            <!-- Service 1 -->
            <div class="flip-box">

                <div class="flip-box-inner">

                    <div class="flip-box-front">
                        <h3>AI Governance Assessment</h3>
                    </div>

                    <div class="flip-box-back">
                        <p>
                            We assess how your organisation currently uses AI,
                            identify governance gaps, evaluate accountability and
                            oversight, and provide a practical roadmap for
                            responsible AI adoption.
                        </p>
                    </div>

                </div>

            </div>


            <!-- Service 2 -->
            <div class="flip-box">

                <div class="flip-box-inner">

                    <div class="flip-box-front">
                        <h3>AI Risk Assessment &amp; Management</h3>
                    </div>

                    <div class="flip-box-back">
                        <p>
                            We identify, assess, and help manage AI-related risks,
                            including privacy, security, bias, accuracy,
                            transparency, operational, third-party, and
                            reputational risks.
                        </p>
                    </div>

                </div>

            </div>


            <!-- Service 3 -->
            <div class="flip-box">

                <div class="flip-box-inner">

                    <div class="flip-box-front">
                        <h3>AI Governance Frameworks &amp; Policies</h3>
                    </div>

                    <div class="flip-box-back">
                        <p>
                            We develop practical AI governance frameworks, policies,
                            procedures, acceptable-use guidelines, roles, and
                            accountability structures tailored to your organisation.
                        </p>
                    </div>

                </div>

            </div>


            <!-- Service 4 -->
            <div class="flip-box">

                <div class="flip-box-inner">

                    <div class="flip-box-front">
                        <h3>AI Compliance &amp; Regulatory Readiness</h3>
                    </div>

                    <div class="flip-box-back">
                        <p>
                            We help organisations identify AI-related compliance
                            gaps and prepare for applicable legal, regulatory, and
                            industry requirements, working with qualified
                            professionals where specialised legal advice is required.
                        </p>
                    </div>

                </div>

            </div>


            <!-- Service 5 -->
            <div class="flip-box">

                <div class="flip-box-inner">

                    <div class="flip-box-front">
                        <h3>AI Vendor &amp; Third-Party Risk</h3>
                    </div>

                    <div class="flip-box-back">
                        <p>
                            We assess AI vendors and third-party technology providers
                            for data handling, privacy, security, operational,
                            contractual, and governance risks before and during
                            adoption.
                        </p>
                    </div>

                </div>

            </div>


            <!-- Service 6 -->
            <div class="flip-box">

                <div class="flip-box-inner">

                    <div class="flip-box-front">
                        <h3>Ongoing AI Governance &amp; Monitoring</h3>
                    </div>

                    <div class="flip-box-back">
                        <p>
                            We provide ongoing governance support through periodic
                            risk reviews, policy updates, AI inventory reviews,
                            vendor assessments, governance reporting, and continuous
                            advisory support.
                        </p>
                    </div>

                </div>

            </div>


            <a href="/contact" class="btn">
                Request an AI Governance Assessment
            </a>

        </section>

    </main>

    <%- include('partials/footer') %>

    <%- include('partials/scripts') %>

</body>

</html>